    "deploy:dry": "wrangler deploy --dry-run"
  },
  "dependencies": {
    "@fontsource/anton": "^5.3.0",
    "@fontsource/dm-mono": "^5.2.7",
    "@fontsource/instrument-sans": "^5.2.8",
    "@fontsource/instrument-serif": "^5.2.8",
    "gsap": "^3.13.0",
    "lenis": "^1.3.15"
  },
  "devDependencies": {
    "puppeteer-core": "^24.15.0",
    "typescript": "^5.9.3",
    "vite": "^7.1.9",
    "wrangler": "^4.42.0"
  }
}
